{
  "name": "magnusarchives-foundryvtt",
  "version": "0.1.0-beta.5",
  "private": true,
  "description": "A modern Foundry VTT v14 system for Cypher V2.",
  "type": "module",
  "scripts": {
    "build": "vite build && pnpm packs:build",
    "packs:build": "node scripts/build-yml-packs.mjs",
    "packs:extract": "node scripts/extract-yml-packs.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "watch": "node scripts/watch.mjs",
    "dev:sync": "node scripts/dev-sync.mjs",
    "dev:world": "node scripts/ensure-world.mjs",
    "dev:seed": "node scripts/seed-dev-world.mjs",
    "foundry:start": "../start_foundry.sh",
    "foundry:restart": "node scripts/restart-foundry.mjs",
    "test:quench:sync": "node scripts/sync-quench-module.mjs",
    "test:e2e": "pnpm --filter magnusarchives-e2e run tests:ci",
    "test:e2e:open": "pnpm --filter magnusarchives-e2e run tests",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "3.0.4",
    "@types/node": "^24.3.0",
    "classic-level": "^3.0.0",
    "js-yaml": "5.4.1",
    "oxfmt": "^0.74.0",
    "sass": "^1.90.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.19.0"
}
