{
  "id": "magnusarchives",
  "title": "The Magnus Archives",
  "description": "An unofficial Foundry VTT v14 system for The Magnus Archives Roleplaying Game, with Stress, the damage track and the book's price categories.",
  "version": "0.1.0-beta.5",
  "manifest": "https://github.com/Achoobert/foundryvtt_magnusarchives/releases/latest/download/system.json",
  "download": "https://github.com/Achoobert/foundryvtt_magnusarchives/releases/latest/download/magnusarchives.zip",
  "compatibility": {
    "minimum": "14",
    "verified": "14.360"
  },
  "authors": [
    {
      "name": "Achoobert"
    },
    {
      "name": "Cypher V2 Contributors"
    }
  ],
  "esmodules": ["dist/magnusarchives.mjs"],
  "styles": ["dist/magnusarchives.css"],
  "media": [
    {
      "type": "setup",
      "url": "systems/magnusarchives/assets/magnusmeta.webp",
      "thumbnail": "systems/magnusarchives/assets/magnusmeta.webp"
    }
  ],
  "packs": [
    {
      "name": "descriptors",
      "label": "Descriptors",
      "path": "packs/descriptors",
      "type": "Item",
      "system": "magnusarchives"
    },
    {
      "name": "skills",
      "label": "Skills",
      "path": "packs/skills",
      "type": "Item",
      "system": "magnusarchives"
    },
    {
      "name": "types",
      "label": "Types",
      "path": "packs/types",
      "type": "Item",
      "system": "magnusarchives"
    },
    {
      "name": "type-abilities",
      "label": "Type Abilities",
      "path": "packs/type-abilities",
      "type": "Item",
      "system": "magnusarchives"
    },
    {
      "name": "foci",
      "label": "Foci",
      "path": "packs/foci",
      "type": "Item",
      "system": "magnusarchives"
    },
    {
      "name": "focus-abilities",
      "label": "Focus Abilities",
      "path": "packs/focus-abilities",
      "type": "Item",
      "system": "magnusarchives"
    },
    {
      "name": "weapons-and-armors",
      "label": "Weapons & Armor",
      "path": "packs/weapons-and-armors",
      "type": "Item",
      "system": "magnusarchives"
    },
    {
      "name": "equipment",
      "label": "Equipment",
      "path": "packs/equipment",
      "type": "Item",
      "system": "magnusarchives"
    },
    {
      "name": "cyphers",
      "label": "Cyphers",
      "path": "packs/cyphers",
      "type": "Item",
      "system": "magnusarchives"
    },
    {
      "name": "cypher-tables",
      "label": "Cypher Tables",
      "path": "packs/cypher-tables",
      "type": "RollTable",
      "system": "magnusarchives"
    },
    {
      "name": "artefacts",
      "label": "Artefacts & Books",
      "path": "packs/artefacts",
      "type": "Item",
      "system": "magnusarchives"
    },
    {
      "name": "npcs",
      "label": "NPCs & Monsters",
      "path": "packs/npcs",
      "type": "Actor",
      "system": "magnusarchives"
    },
    {
      "name": "example-characters",
      "label": "Example Characters",
      "path": "packs/example-characters",
      "type": "Actor",
      "system": "magnusarchives"
    }
  ],
  "documentTypes": {
    "Actor": {
      "character": {
        "htmlFields": [
          "description",
          "notes",
          "gmNotes",
          "advancement.notes",
          "wounds.minor.*.description",
          "wounds.moderate.*.description",
          "wounds.major.*.description"
        ]
      },
      "npc": {
        "htmlFields": ["description", "notes", "gmNotes", "gmIntrusion"]
      }
    },
    "Item": {
      "ability": {
        "htmlFields": ["description"]
      },
      "skill": {
        "htmlFields": ["acquisition.notes"]
      },
      "weapon": {
        "htmlFields": ["description"]
      },
      "armor": {
        "htmlFields": ["description"]
      },
      "shield": {
        "htmlFields": [
          "description",
          "wounds.minor.*.description",
          "wounds.moderate.*.description",
          "wounds.major.*.description"
        ]
      },
      "equipment": {
        "htmlFields": ["description"]
      },
      "cypher": {
        "htmlFields": ["description"]
      },
      "artifact": {
        "htmlFields": ["description"]
      },
      "descriptor": {
        "htmlFields": ["description"]
      },
      "characterType": {
        "htmlFields": ["description", "backgroundOptions", "equipmentNotes"]
      },
      "focus": {
        "htmlFields": ["description"]
      },
      "genre": {
        "htmlFields": ["description"]
      },
      "species": {
        "htmlFields": ["description"]
      }
    }
  },
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "socket": true,
  "grid": {
    "distance": 1.5,
    "units": "m"
  },
  "license": "LICENSE.md",
  "readme": "README.md"
}
