<article class="magnusarchives magnusarchives-chat-card magnusarchives-roll-card magnusarchives-ability-card"{{#if chatCardStyle}} style="{{chatCardStyle}}"{{/if}}>
  {{#if actorImage}}<img class="magnusarchives-chat-watermark" src="{{actorImage}}" alt="" aria-hidden="true">{{/if}}
  <header><h3>{{abilityName}}</h3><span>{{actorName}} · {{activation}}</span></header>
  {{#if targetName}}<p>{{localize "MAGNUSARCHIVES.Combat.Target"}}: {{targetName}}</p>{{/if}}
  <p class="roll-outcome success">{{localize "MAGNUSARCHIVES.Ability.Used"}}</p>
  {{#if damage}}<p class="combat-result"><strong>{{localize "MAGNUSARCHIVES.Combat.Damage"}}: {{damage}}</strong></p>{{/if}}
  {{#if damageEffect}}<p class="combat-result"><strong>{{localize "MAGNUSARCHIVES.Npc.DamageEffect"}}: {{damageEffect}}{{#if stressAmount}} ({{stressAmount}}){{/if}}</strong></p>{{/if}}
  {{#if combatAction}}<button type="button" class="magnusarchives-combat-action" data-action="applyCombatOutcome">{{combatActionLabel}}</button>{{/if}}
  <details class="roll-card-disclosure roll-card-details"><summary>{{localize "MAGNUSARCHIVES.Common.Details"}}</summary><div class="roll-card-detail-content"><dl class="roll-card-detail-list">{{#if poolLabel}}<dt>{{localize "MAGNUSARCHIVES.Pools.Pool"}}</dt><dd>{{poolLabel}}</dd>{{/if}}<dt>{{localize "MAGNUSARCHIVES.Roll.CostPaid"}}</dt><dd>{{costPaid}}</dd></dl></div></details>
</article>
