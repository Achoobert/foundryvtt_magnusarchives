<article class="magnusarchives magnusarchives-chat-card magnusarchives-depletion-card"{{#if chatCardStyle}} style="{{chatCardStyle}}"{{/if}}>
  {{#if actorImage}}<img class="magnusarchives-chat-watermark" src="{{actorImage}}" alt="" aria-hidden="true">{{/if}}
  <header><h3>{{localize "MAGNUSARCHIVES.Depletion.Roll"}} — {{itemName}}</h3></header>
  <p>{{formula}}: <strong>{{total}}</strong></p>
  <p class="roll-outcome {{#if depleted}}failure{{else}}success{{/if}}"><strong>{{outcome}}</strong></p>
</article>
