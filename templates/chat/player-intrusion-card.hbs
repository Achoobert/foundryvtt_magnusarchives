<article class="magnusarchives magnusarchives-chat-card intrusion-card player-intrusion-card has-exceptional-result"{{#if chatCardStyle}} style="{{chatCardStyle}}"{{/if}}>
  {{#if actorImage}}<img class="magnusarchives-chat-watermark" src="{{actorImage}}" alt="" aria-hidden="true">{{/if}}
  <header class="intrusion-card-heading">
    <i class="fa-solid fa-bolt" aria-hidden="true"></i>
    <h3>{{localize "MAGNUSARCHIVES.Intrusion.Player.Title"}}</h3>
  </header>
  <div class="intrusion-card-identity">
    {{#if actorImage}}<img class="intrusion-card-portrait" src="{{actorImage}}" alt="">{{/if}}
    <p class="intrusion-card-message">{{localize "MAGNUSARCHIVES.Intrusion.Player.Chat" character=actorName}}</p>
  </div>
  <strong class="intrusion-card-xp">{{localize "MAGNUSARCHIVES.Intrusion.Player.Spent" xp=xpSpent}}</strong>
</article>
