<article class="magnusarchives magnusarchives-chat-card magnusarchives-defense-request-card"{{#if chatCardStyle}} style="{{chatCardStyle}}"{{/if}}>
  {{#if actorImage}}<img class="magnusarchives-chat-watermark" src="{{actorImage}}" alt="" aria-hidden="true">{{/if}}
  <header><h3>{{localize "MAGNUSARCHIVES.Combat.NpcAttack"}}</h3></header>
  <p>{{sourceName}} → {{targetName}}</p>
  <p>{{localize "MAGNUSARCHIVES.Npc.DamageEffect"}}: {{damageEffect}}{{#if stressAmount}} ({{stressAmount}}){{/if}}</p>
  <div class="defense-request-actions">
    {{#if allowDodge}}<button type="button" data-action="rollRequestedDefense" data-defense="dodge">{{localize "MAGNUSARCHIVES.Combat.Defense.dodge"}}</button>{{/if}}
    {{#if allowBlock}}<button type="button" data-action="rollRequestedDefense" data-defense="block">{{localize "MAGNUSARCHIVES.Combat.Defense.block"}}</button>{{/if}}
    {{#if allowBlockWithShield}}<button type="button" data-action="rollRequestedDefense" data-defense="blockWithShield">{{localize "MAGNUSARCHIVES.Combat.Defense.blockWithShield"}}</button>{{/if}}
  </div>
</article>
