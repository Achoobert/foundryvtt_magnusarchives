      "levelOverride": false,
      "levelFormula": "1d6 + 1",
      "instant": true,
      "form": "",
      "description": "<p><strong>Level:</strong> 1d6 + 1 · <strong>Instant.</strong></p><p>As part of a physical action (an attack, a bump, a shout, shoving past), you make an NPC within immediate range drop whatever they hold, if their level is lower than the cypher's level.</p>",
      "sourcePage": "107",
      "sourceOrder": 5,
      "nonstandard": false,
      "reviewStatus": "verified",
      "reviewNote": ""
    },
    {
