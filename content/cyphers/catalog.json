      "levelFormula": "1d6 + 2",
      "instant": false,
      "form": "",
      "description": "<p><strong>Level:</strong> 1d6 + 2</p><p>Add 1 to your Intellect Edge for one hour (2 if the cypher is level 5 or higher).</p>",
