      "nonstandard": false,
      "reviewStatus": "verified",
      "reviewNote": ""
    },
    {
      "id": "dance-through-the-maze",
      "name": "Dance Through the Maze",
      "category": "standard",
      "manifestation": "subtle",
      "power": null,
      "level": null,
      "levelOverride": false,
      "levelFormula": "1d6",
      "instant": false,
      "form": "",
      "description": "<p><strong>Level:</strong> 1d6</p><p>For one hour, ease every task of manual dexterity (pickpocketing, lockpicking, juggling, surgery, defusing a bomb and the like) by one step, or by two steps if the cypher is level 5 or higher.</p>",
      "sourcePage": "108",
      "sourceOrder": 9,
      "nonstandard": false,
      "reviewStatus": "verified",
      "reviewNote": ""
    },
    {
      "id": "deathly-silent-and-still",
