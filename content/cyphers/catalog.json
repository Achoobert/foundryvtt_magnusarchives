      "levelFormula": "1d6 + 4",
      "instant": true,
      "form": "",
      "description": "<p><strong>Level:</strong> 1d6 + 4 · <strong>Instant.</strong></p><p>Pass simple information to a known ally who can see you, using only looks, gestures or references. Only the two of you notice anything was said. The message is about one word per cypher level.</p>",
      "sourcePage": "108",
      "sourceOrder": 12,
      "nonstandard": false,
      "reviewStatus": "verified",
      "reviewNote": ""
    },
    {
