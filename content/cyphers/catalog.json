      "levelFormula": "1d6",
      "instant": true,
      "form": "",
      "description": "<p><strong>Level:</strong> 1d6 · <strong>Instant.</strong></p><p>Apply one free level of Effort to one task without spending Pool points. It does not count toward the most Effort you can normally apply.</p>",
      "sourcePage": "108",
