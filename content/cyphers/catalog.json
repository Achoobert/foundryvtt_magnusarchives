      "reviewStatus": "verified",
      "reviewNote": ""
    },
    {
      "id": "spirals-luck",
      "name": "Spiral's Luck",
      "category": "standard",
      "manifestation": "subtle",
      "power": null,
      "level": null,
      "levelOverride": false,
      "levelFormula": "1d6",
      "instant": true,
      "form": "",
      "description": "<p><strong>Level:</strong> 1d6 · <strong>Instant.</strong></p><p>An attack that would give you a serious injury gives you 2 points of Stress instead.</p>",
      "sourcePage": "112",
      "sourceOrder": 38,
      "nonstandard": false,
      "reviewStatus": "verified",
      "reviewNote": ""
    },
    {
      "id": "squirm",
      "name": "Squirm",
      "category": "standard",
      "manifestation": "subtle",
      "power": null,
      "level": null,
      "levelOverride": false,
      "levelFormula": "1d6",
      "instant": true,
      "form": "",
      "description": "<p><strong>Level:</strong> 1d6 · <strong>Instant.</strong></p><p>Ease the action you are taking by three steps.</p>",
      "sourcePage": "112",
      "sourceOrder": 39,
      "nonstandard": false,
      "reviewStatus": "verified",
      "reviewNote": ""
    },
    {
      "id": "stare-into-the-vast",
      "name": "Stare Into The Vast",
      "category": "standard",
      "manifestation": "subtle",
      "power": null,
      "level": null,
      "levelOverride": false,
      "levelFormula": "1d6 + 2",
      "instant": false,
      "form": "",
      "description": "<p><strong>Level:</strong> 1d6 + 2</p><p>Regain points to your Intellect Pool equal to the cypher's level.</p>",
      "sourcePage": "112",
      "sourceOrder": 40,
      "nonstandard": false,
      "reviewStatus": "verified",
      "reviewNote": ""
    },
    {
      "id": "strange-music",
      "name": "Strange Music",
      "category": "standard",
      "manifestation": "subtle",
      "power": null,
      "level": null,
      "levelOverride": false,
      "levelFormula": "1d6",
      "instant": false,
      "form": "",
      "description": "<p><strong>Level:</strong> 1d6</p><p>Lose Stress equal to the cypher's level.</p>",
      "sourcePage": "112",
      "sourceOrder": 41,
      "nonstandard": false,
      "reviewStatus": "verified",
      "reviewNote": ""
    },
    {
      "id": "taking-stock",
      "name": "Taking Stock",
      "category": "standard",
      "manifestation": "subtle",
      "power": null,
      "level": null,
      "levelOverride": false,
      "levelFormula": "1d6 + 2",
      "instant": false,
      "form": "",
      "description": "<p><strong>Level:</strong> 1d6 + 2</p><p>Ask the GM one question and get a general answer. The GM gives the question a level, and the cypher can't answer a question above its own level. As a guide, knowledge found elsewhere than where you are is level 1, obscure knowledge of the past is level 7, and knowledge of the future is level 10 and always open to interpretation.</p>",
      "sourcePage": "112",
      "sourceOrder": 42,
      "nonstandard": false,
      "reviewStatus": "verified",
      "reviewNote": ""
    },
    {
      "id": "thought-for-the-day",
      "name": "Thought for the Day",
      "category": "standard",
      "manifestation": "subtle",
      "power": null,
      "level": null,
      "levelOverride": false,
      "levelFormula": "1d6",
      "instant": false,
      "form": "",
      "description": "<p><strong>Level:</strong> 1d6</p><p>Recall a relevant detail about the current situation, of a kind normal research could turn up.</p>",
      "sourcePage": "112",
      "sourceOrder": 43,
      "nonstandard": false,
      "reviewStatus": "verified",
      "reviewNote": ""
    },
    {
      "id": "thrill-of-the-chase",
      "name": "Thrill of the Chase",
      "category": "standard",
      "manifestation": "subtle",
      "power": null,
      "level": null,
      "levelOverride": false,
      "levelFormula": "1d6",
      "instant": false,
      "form": "",
      "description": "<p><strong>Level:</strong> 1d6</p><p>For one minute, you can move a long distance instead of a short distance as an action.</p>",
      "sourcePage": "112",
      "sourceOrder": 44,
      "nonstandard": false,
      "reviewStatus": "verified",
      "reviewNote": ""
    },
    {
      "id": "tightrope",
      "name": "Tightrope",
      "category": "standard",
      "manifestation": "subtle",
      "power": null,
      "level": null,
      "levelOverride": false,
      "levelFormula": "1d6 + 2",
      "instant": false,
      "form": "",
      "description": "<p><strong>Level:</strong> 1d6 + 2</p><p>Add 1 to your Speed Edge for one hour (2 if the cypher is level 5 or higher).</p>",
      "sourcePage": "112",
      "sourceOrder": 45,
      "nonstandard": false,
      "reviewStatus": "verified",
      "reviewNote": ""
    },
    {
      "id": "uncanny-valley",
      "name": "Uncanny Valley",
      "category": "standard",
      "manifestation": "subtle",
      "power": null,
      "level": null,
      "levelOverride": false,
      "levelFormula": "1d6 + 3",
      "instant": true,
      "form": "",
      "description": "<p><strong>Level:</strong> 1d6 + 3 · <strong>Instant.</strong></p><p>After talking with someone for at least a couple of rounds, ease one deception or persuasion task against them by three steps.</p>",
      "sourcePage": "112",
      "sourceOrder": 46,
      "nonstandard": false,
      "reviewStatus": "verified",
      "reviewNote": ""
    },
    {
      "id": "watchers-know-how",
      "name": "Watcher's Know-How",
      "category": "standard",
      "manifestation": "subtle",
      "power": null,
      "level": null,
      "levelOverride": false,
      "levelFormula": "1d6",
      "instant": false,
      "form": "",
      "description": "<p><strong>Level:</strong> 1d6</p><p>You know where to look, or who to ask, to find a significant piece of information. The GM may offer more than one lead. Use it when you start researching or while searching for clues.</p>",
      "sourcePage": "112",
      "sourceOrder": 47,
      "nonstandard": false,
      "reviewStatus": "verified",
      "reviewNote": ""
    },
    {
      "id": "weavers-encouragement",
      "name": "Weaver's Encouragement",
      "category": "standard",
      "manifestation": "subtle",
      "power": null,
      "level": null,
      "levelOverride": false,
      "levelFormula": "1d6",
      "instant": false,
      "form": "",
      "description": "<p><strong>Level:</strong> 1d6</p><p>Someone next to you gains an asset on their next task. If the cypher is level 5 or higher, you can encourage up to three characters at once.</p>",
      "sourcePage": "112",
      "sourceOrder": 48,
      "nonstandard": false,
      "reviewStatus": "verified",
      "reviewNote": ""
    },
    {
      "id": "well-being",
      "name": "Well-Being",
      "category": "standard",
      "manifestation": "subtle",
      "power": null,
      "level": null,
      "levelOverride": false,
      "levelFormula": "1d6",
      "instant": false,
      "form": "",
      "description": "<p><strong>Level:</strong> 1d6</p><p>For one round per cypher level, act as if you were one step higher on the damage track than you are, as long as you are not dead (Damage track, p132).</p>",
      "sourcePage": "112",
      "sourceOrder": 49,
      "nonstandard": false,
      "reviewStatus": "verified",
      "reviewNote": ""
    },
    {
      "id": "what-we-all-ignore",
      "name": "What We All Ignore",
      "category": "standard",
      "manifestation": "subtle",
      "power": null,
      "level": null,
      "levelOverride": false,
      "levelFormula": "1d6",
      "instant": false,
      "form": "",
      "description": "<p><strong>Level:</strong> 1d6</p><p>For one hour per cypher level, reduce the Stress you suffer from mental shock or despair by 1 each time. Stress from physical injury is unchanged.</p>",
      "sourcePage": "113",
      "sourceOrder": 50,
      "nonstandard": false,
      "reviewStatus": "verified",
      "reviewNote": ""
    },
    {
      "id": "what-we-lose",
      "name": "What We Lose",
      "category": "standard",
      "manifestation": "subtle",
      "power": null,
      "level": null,
      "levelOverride": false,
      "levelFormula": "1d6 + 3",
      "instant": true,
      "form": "",
      "description": "<p><strong>Level:</strong> 1d6 + 3 · <strong>Instant.</strong></p><p>Brushing past someone, you lift something from their pocket, bag or other container, if they carry anything. Ease the pickpocketing task by two steps, or by four if the cypher is level 7 or higher.</p>",
      "sourcePage": "113",
      "sourceOrder": 51,
      "nonstandard": false,
      "reviewStatus": "verified",
      "reviewNote": ""
    },
    {
      "id": "words-of-the-puppeteer",
      "name": "Words of The Puppeteer",
      "category": "standard",
      "manifestation": "subtle",
      "power": null,
      "level": null,
      "levelOverride": false,
      "levelFormula": "1d6",
      "instant": true,
      "form": "",
      "description": "<p><strong>Level:</strong> 1d6 · <strong>Instant.</strong></p><p>Gain one extra asset on any one task of verbal interaction, even past the normal limit of two assets.</p>",
      "sourcePage": "113",
      "sourceOrder": 52,
      "nonstandard": false,
      "reviewStatus": "verified",
      "reviewNote": ""
    }
  ],
