      "manifestation": "subtle",
      "power": null,
      "level": null,
      "levelOverride": false,
      "levelFormula": "1d6",
      "instant": true,
      "form": "",
      "description": "<p><strong>Level:</strong> 1d6 · <strong>Instant.</strong></p><p>If there is any way to conceal yourself, nobody is aware of you for one round.</p>",
      "sourcePage": "108",
      "sourceOrder": 10,
      "nonstandard": false,
      "reviewStatus": "verified",
      "reviewNote": ""
    },
    {
      "id": "desperate-effort",
