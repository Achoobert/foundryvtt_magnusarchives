        {
          "inline": {
            "name": "Careful Observation",
            "type": "ability",
            "img": "systems/magnusarchives/assets/icons/magnusability.webp",
            "system": {
              "schemaVersion": 1,
              "description": "<p>Spend a minute studying your surroundings. Succeed at a difficulty 4 perception task and you pick out an inanimate detail within immediate distance that bears on your current investigation: the colour of mud on a pair of boots, a thread caught on a coat hook, dust disturbed on one shelf. If there is nothing of the sort there, you learn that too. Two or more such details still take only one roll: the first comes at difficulty 4, the second at 5, the third at 6, and so on.</p>",
              "source": {
                "book": "The Magnus Archives Roleplaying Game",
                "page": "379",
                "license": "original"
              },
